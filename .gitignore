# Carpeta privada / borradores internos / material docente restringido
_privado/
_internal/
docs_privados/

# Entornos y Secretos
.env
.env.local
.env.*.local
*.local

# Gradle caches, daemons & binaries
.gradle/
build/
**/build/
**/.gradle/

# Binarios Java / Kotlin
*.class
*.jar
*.war
*.ear
!gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Bases de datos locales
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
**/data/*.db
**/data/simacmart.db

# IDEs (IntelliJ IDEA, VS Code, Eclipse)
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
.settings/
.classpath
.project

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Graphify / Herramientas de análisis
graphify-out/
